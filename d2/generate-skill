def tour_path(name: str) -> Path:
    matches = list((DOCS_REPO / "docs/tour").glob(f"{name}.md*"))
    require(len(matches) == 1, f"expected one tour page named {name}, found {matches}")
    return matches[0]


def clean_mdx(src: str, path: Path) -> str:
    """Turn a docusaurus page into plain markdown, inlining the D2 sources it imports."""
    src = re.sub(r"\A---\n.*?\n---\n", "", src, flags=re.DOTALL)
    imports = dict(
        re.findall(r"^import (\w+) from '@site/(\S+?)';$", src, flags=re.MULTILINE)
    )
    src = re.sub(r"^import .*$\n", "", src, flags=re.MULTILINE)
    src = re.sub(
        r"<CodeBlock[^>]*>\s*\{(\w+)\}\s*</CodeBlock>",
        lambda match: imported_d2(match.group(1), imports, path),
        src,
    )
    src = re.sub(r"<div\b.*?</div>", "", src, flags=re.DOTALL)
    src = re.sub(
        r"<(?:WebPImage|embed|video|img|source)\b[^>]*?/?>", "", src, flags=re.DOTALL
    )
    src = re.sub(r"^:::\w*.*$\n?", "", src, flags=re.MULTILINE)
    src = drop_empty_sections(src)
    src = re.sub(r"\n{3,}", "\n\n", src).strip() + "\n"
    leftover = [
        line
        for line in src.splitlines()
        if re.search(r"<CodeBlock|<div|require\(|@site/", line)
    ]
    require(not leftover, f"{path}: unhandled JSX: {leftover[:3]}")
    return src


def imported_d2(name: str, imports: dict[str, str], path: Path) -> str:
    if name not in imports:
        fail(f"{path}: <CodeBlock> uses {name}, which is not imported from @site")
    return fence((DOCS_REPO / imports[name]).read_text())


def fence(code: str, language: str = "d2") -> str:
    """Fence a code block, outrunning any backticks the code itself contains."""
    longest = max((len(run) for run in re.findall(r"`+", code)), default=0)
    backticks = "`" * max(3, longest + 1)
    return f"{backticks}{language}\n{code.strip()}\n{backticks}"


def drop_empty_sections(markdown: str) -> str:
    """Drop headings left content-free by the images the docs render but this skill omits."""
    lines = markdown.splitlines()
    headings = [(i, len(m.group(1))) for i, m in headings_in(lines)]
    headings.append((len(lines), 0))
    empty = {
        i
        for (i, level), (next_i, next_level) in pairwise(headings)
        if next_level <= level
        and not any(line.strip() for line in lines[i + 1 : next_i])
    }
    return "\n".join(line for i, line in enumerate(lines) if i not in empty)


def headings_in(lines: list[str]) -> list[tuple[int, re.Match[str]]]:
    """Locate markdown headings, ignoring code fences: `#` is a comment in D2 and shell."""
    found: list[tuple[int, re.Match[str]]] = []
    fenced = False
    for i, line in enumerate(lines):
        if line.startswith("```"):
            fenced = not fenced
        elif not fenced and (match := re.match(r"(#{1,6}) ", line)):
            found.append((i, match))
    return found


def demote(markdown: str, levels: int) -> str:
    """Push headings down, so that a whole page nests under a section of SKILL.md."""
    chunks = markdown.split("```")
    for i in range(0, len(chunks), 2):
        chunks[i] = re.sub(
            r"^(#{1,6}) ",
            lambda match: "#" * min(6, len(match.group(1)) + levels) + " ",
            chunks[i],
            flags=re.MULTILINE,
        )
    return "```".join(chunks)


def go_map_keys(path: Path, symbol: str) -> list[str]:
    body = go_declaration(path, symbol)
    entries = re.findall(r"^\t(.+?):\s*\{\},?$", body, flags=re.MULTILINE)
    keys = [resolve_go_string(path, entry) for entry in entries]
    require(len(keys) > 0, f"{path}: no keys in {symbol}")
    return sorted(keys)


def go_slice(path: Path, symbol: str) -> list[str]:
    body = go_declaration(path, symbol)
    entries = re.findall(r'"[^"]*"|^\t\w+,$', body, flags=re.MULTILINE)
    values = [resolve_go_string(path, entry.rstrip(",")) for entry in entries]
    require(len(values) > 0, f"{path}: no entries in {symbol}")
    return values


def go_declaration(path: Path, symbol: str) -> str:
    src = path.read_text()
    declaration = rf"^var {re.escape(symbol)} = [^\n]*"
    multiline = re.search(
        declaration + r"\{\n(.*?)^\}$", src, flags=re.MULTILINE | re.DOTALL
    )
    if multiline is not None:
        return multiline.group(1)
    single = re.search(
        declaration.replace("*", "*?") + r"\{([^{}]*)\}$", src, flags=re.MULTILINE
    )
    if single is not None:
        return single.group(1)
    fail(f"{path}: no declaration of {symbol}")


def resolve_go_string(path: Path, expression: str) -> str:
    expression = expression.strip()
    if literal := re.fullmatch(r'"(.*)"', expression):
        return literal.group(1)
    reference = re.fullmatch(r"(?:string\()?(\w+)\)?", expression)
    if reference is None:
        fail(f"{path}: cannot resolve {expression!r} to a string")
    constant = reference.group(1)
    value = re.search(
        rf'^\t{re.escape(constant)} +(?:\w+ +)?= "([^"]+)"$',
        path.read_text(),
        flags=re.MULTILINE,
    )
    if value is None:
        fail(f"{path}: no constant {constant}")
    return value.group(1)


def value_ranges() -> str:
    body = go_function(D2_REPO / "d2lsp/completion.go", "getValueCompletions")
    cases = re.findall(
        r'case ([^:]+):\n\s*return \[\]CompletionItem\{\{\n\s*Label:\s*"([^"]+)",'
        r'\n[^\n]*\n\s*Detail:\s*"([^"]+)"',
        body,
    )
    require(len(cases) > 5, f"only {len(cases)} value ranges extracted")
    lines = []
    for properties, label, detail in cases:
        keys = ", ".join(f"`{key.strip().strip('"')}`" for key in properties.split(","))
        lines.append(f"- {keys}: {label.strip('()')}, {detail}")
    return "\n".join(lines)


def go_function(path: Path, name: str) -> str:
    pattern = rf"^func {re.escape(name)}\(.*?\n(.*?)^\}}$"
    match = re.search(pattern, path.read_text(), flags=re.MULTILINE | re.DOTALL)
    if match is None:
        fail(f"{path}: no func {name}")
    return match.group(1)


def git_version(repo: Path) -> str:
    return run("git", "-C", str(repo), "describe", "--tags", "--always").strip()


def run(*command: str) -> str:
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    require(
        result.returncode == 0, f"{' '.join(command)} failed: {result.stderr.strip()}"
    )
    return result.stdout


def require(condition: bool, message: str) -> None:
    if not condition:
        fail(message)


def fail(message: str) -> NoReturn:
    sys.exit(f"generate-skill: {message}")


main()
