"""Generate SKILL.md for the d2 skill from the vendored D2 source and docs repos.

Run via `make d2` from the skills repo root.
"""

import json
import re
import subprocess
import sys
from itertools import pairwise
from pathlib import Path
from typing import NoReturn

SKILL_DIR = Path(__file__).resolve().parent
D2_REPO = SKILL_DIR / "d2"
DOCS_REPO = SKILL_DIR / "d2-docs"
OUT = SKILL_DIR / "SKILL.md"

# Language docs to inline, in sidebar order (d2-docs/sidebars.ts). Pages about installing
# D2, editor plugins, the Go API, the cheat sheet PDF, and the project itself are omitted;
# they are listed at the end of the skill instead.
TOUR = [
    "hello-world", "shapes", "connections", "containers",
    "text", "icons", "sql-tables", "uml-classes", "sequence-diagrams", "grid-diagrams",
    "themes", "style", "classes", "dimensions", "positions", "sketch", "interactive",
    "fonts", "layouts", "dagre", "elk", "tala",
    "strings", "vars", "globs", "comments", "overrides", "models", "legend",
    "auto-formatter",
    "composition", "layers", "scenarios", "steps", "linking", "composition-formats",
    "imports", "imports-use-cases", "model-view", "modular-classes",
    "nested-composition", "version-visualization", "imported-template",
    "exports", "troubleshoot",
]  # fmt: skip


def main() -> None:
    sections = [
        frontmatter(),
        rendering(),
        temporal_conventions(),
        provenance(),
        cli_reference(),
        vocabulary(),
        language_tour(),
        tala_gallery(),
        repo_examples(),
        further_material(),
    ]
    body = "\n".join(sections)
    OUT.write_text(body)
    print(f"{OUT}: {len(body) / 1024:.0f} KiB, {body.count('\n') + 1} lines")


def frontmatter() -> str:
    return (
        "---\n"
        "name: d2\n"
        "description: |\n"
        "  The D2 diagram language: language reference, examples, and CLI documentation,\n"
        "  generated from the D2 source and docs repositories vendored in this skill.\n"
        "  Diagrams are rendered with the TALA layout engine.\n"
        "---\n"
    )


def provenance() -> str:
    return f"""
## Sources

Everything below is upstream material, assembled by `{SKILL_DIR}/generate-skill`
(regenerate with `make d2`) from:

- `{D2_REPO}` — D2 source, {git_version(D2_REPO)}
- `{DOCS_REPO}` — D2 language docs, {git_version(DOCS_REPO)}
