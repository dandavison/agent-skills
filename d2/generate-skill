    tour = (DOCS_REPO / "docs/tour").glob("*.md*")
    omitted = sorted(page.stem for page in tour if page.stem not in TOUR)
    diagrams = sorted(
        (
            (p.stat().st_size, p.name)
            for p in (D2_REPO / "e2etests/testdata/files").glob("*.d2")
        ),
        reverse=True,
    )
    largest = ", ".join(f"`{name}`" for _, name in diagrams[:10])
    return f"""
