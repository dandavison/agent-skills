#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""
Reorder a unified diff so that hunks appear in [WALKTHROUGH i/N] order.

Usage: reorder-diff <input.diff> <output.diff>

The script:
1. Parses a unified diff into (file-header, hunk) pairs
2. Finds [WALKTHROUGH i/N] markers in each hunk
3. Orders hunks by walkthrough number
4. Strips other walkthrough markers from each hunk's context lines
   (each marker appears only in its own hunk)
5. Emits valid unified diff
"""

from __future__ import annotations

import re
import subprocess
import sys
from dataclasses import dataclass, field

MARKER_RE = re.compile(r"\[WALKTHROUGH\s+(\d+)/(\d+)\]")


@dataclass
class Hunk:
    header: str  # @@ ... @@
    lines: list[str] = field(default_factory=list)


@dataclass
class FileDiff:
    header_lines: list[str] = field(default_factory=list)  # diff --git ... +++ b/...
    hunks: list[Hunk] = field(default_factory=list)


def parse_diff(text: str) -> list[FileDiff]:
    files: list[FileDiff] = []
    current: FileDiff | None = None
    current_hunk: Hunk | None = None

    for line in text.splitlines(keepends=True):
        if line.startswith("diff --git "):
            current = FileDiff()
            files.append(current)
            current.header_lines.append(line)
            current_hunk = None
        elif current is not None and current_hunk is None:
            if line.startswith("@@ "):
                # First hunk header — don't include in file header
                current_hunk = Hunk(header=line)
                current.hunks.append(current_hunk)
            else:
                # Still in file header (---, +++, index, etc.)
                current.header_lines.append(line)
        elif line.startswith("@@ ") and current is not None:
            current_hunk = Hunk(header=line)
            current.hunks.append(current_hunk)
        elif current_hunk is not None:
            current_hunk.lines.append(line)

    return files


@dataclass
class WalkthroughHunk:
    walkthrough_num: int
    file_header: str  # joined header lines for the parent file
    hunk: Hunk


def extract_walkthrough_hunks(files: list[FileDiff]) -> list[WalkthroughHunk]:
    """Find all walkthrough markers, splitting hunks that contain multiple."""
    results: list[WalkthroughHunk] = []
    for f in files:
        file_header = "".join(f.header_lines)
        for hunk in f.hunks:
            all_text = hunk.header + "".join(hunk.lines)
            matches = list(MARKER_RE.finditer(all_text))
            for m in matches:
                results.append(
                    WalkthroughHunk(
                        walkthrough_num=int(m.group(1)),
                        file_header=file_header,
                        hunk=hunk,
                    )
                )
    return results


COMMENT_LINE_RE = re.compile(r"^[ +]\s*(//|#|--|/\*|\*|;;|%|<!--|-->)\s")


def strip_other_markers(hunk: Hunk, keep_num: int) -> Hunk:
    """Remove lines belonging to other walkthrough comments (marker + continuations)."""
    new_lines: list[str] = []
    stripping = False
    for line in hunk.lines:
        m = MARKER_RE.search(line)
        if m and int(m.group(1)) != keep_num:
            stripping = True
            continue
        if m:
            # This is our marker — stop stripping continuations from a prior marker
            stripping = False
        elif stripping:
            # Strip continuation comment lines that follow a removed marker
            if line.startswith(("+", " ")) and COMMENT_LINE_RE.match(line):
                continue
            stripping = False
        new_lines.append(line)
    return Hunk(header=hunk.header, lines=new_lines)


def recount_hunk(hunk: Hunk) -> Hunk:
    """Recompute the @@ line counts after stripping lines."""
    old_count = 0
    new_count = 0
    for line in hunk.lines:
        if line.startswith(" "):
            old_count += 1
            new_count += 1
        elif line.startswith("+"):
            new_count += 1
        elif line.startswith("-"):
            old_count += 1
        elif line.startswith("\\"):
            pass  # "\ No newline at end of file"

    # Preserve the original start lines from the header
    m = re.match(r"@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@(.*)", hunk.header)
    if m:
        old_start = m.group(1)
        new_start = m.group(2)
        rest = m.group(3)
        new_header = f"@@ -{old_start},{old_count} +{new_start},{new_count} @@{rest}\n"
        return Hunk(header=new_header, lines=hunk.lines)
    return hunk


def emit(walkthrough_hunks: list[WalkthroughHunk]) -> str:
    walkthrough_hunks.sort(key=lambda wh: wh.walkthrough_num)
    parts: list[str] = []
    prev_file_header: str | None = None

    for wh in walkthrough_hunks:
        cleaned = strip_other_markers(wh.hunk, wh.walkthrough_num)
        cleaned = recount_hunk(cleaned)

        if wh.file_header != prev_file_header:
            parts.append(wh.file_header)
            prev_file_header = wh.file_header

        parts.append(cleaned.header)
        parts.append("".join(cleaned.lines))

    return "".join(parts)


def validate_diff(path: str) -> None:
    """Use git to validate the diff is well-formed."""
    result = subprocess.run(
        ["git", "apply", "--stat", path],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"ERROR: invalid diff: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(1)


def main() -> None:
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <input.diff> <output.diff>", file=sys.stderr)
        sys.exit(1)

    input_path = sys.argv[1]
    output_path = sys.argv[2]

    with open(input_path) as f:
        text = f.read()

    files = parse_diff(text)
    wh = extract_walkthrough_hunks(files)

    if not wh:
        print("Warning: no [WALKTHROUGH i/N] markers found in diff", file=sys.stderr)
        # Write original diff as-is
        with open(output_path, "w") as f:
            f.write(text)
        sys.exit(0)

    total = max(h.walkthrough_num for h in wh)
    found = {h.walkthrough_num for h in wh}
    expected = set(range(1, total + 1))
    if found != expected:
        missing = sorted(expected - found)
        print(f"Warning: missing walkthrough steps: {missing}", file=sys.stderr)

    result = emit(wh)

    with open(output_path, "w") as f:
        f.write(result)

    validate_diff(output_path)

    print(f"Wrote {len(wh)} walkthrough hunks to {output_path}", file=sys.stderr)


if __name__ == "__main__":
    main()
