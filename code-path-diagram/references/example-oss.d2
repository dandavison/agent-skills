  style.fill: "#ffffff"
  link: "https://github.com/temporalio/temporal/blob/f8bbf7c78/service/history/api/consistency_checker.go#L228"
}

branch -> get_current_lease: "RunID is empty" {
  style.stroke-dash: 5
}

