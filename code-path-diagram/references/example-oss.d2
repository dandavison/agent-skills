  style.stroke-width: 3
}

get_current_exec -> get_wf_lease: "resolved RunID"

# After getWorkflowLease, if execution is not running,
# double-checks current RunID hasn't changed
recheck: "Re-check: GetCurrentChasmRunID\nconsistency_checker.go:261\n(only if execution not running;\nguards against current-run races)" {
  style.fill: "#f5a0a0"
  style.stroke: "#a01010"
  style.stroke-width: 3
  link: "https://github.com/temporalio/temporal/blob/f8bbf7c78/service/history/api/consistency_checker.go#L261"
}

get_current_lease -> recheck: "if not running" {
